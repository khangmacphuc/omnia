{
  "name": "subagent_no_budget",
  "description": "Delegation remains available when no session token budget is configured.",
  "tools": "builtin_task",
  "permission_mode": "full",
  "workspace": { "files": { "data.txt": "unbounded-fixture\n" } },
  "allow_unused_turns": true,
  "prompts": ["Delegate an unbounded lookup."],
  "script": [
    { "tool_calls": [{ "name": "task", "input": { "description": "unbounded lookup", "prompt": "Read data.txt and report it.", "subagent_type": "explore" } }], "usage": { "input": 1000, "output": 0 } },
    { "kind": "subagent", "tool_calls": [{ "name": "read_file", "input": { "path": "data.txt" } }], "usage": { "input": 1000, "output": 0 } },
    { "kind": "subagent", "say": "UNBOUNDED_CHILD_FINISHED", "usage": { "input": 1000, "output": 0 } },
    { "say": "UNBOUNDED_PARENT_FINISHED", "usage": { "input": 1000, "output": 0 } }
  ],
  "expect": {
    "stop": "end_turn",
    "executed": { "exact": ["task", "read_file"] },
    "events": { "budget_warning": { "eq": 0 }, "run_completed": { "eq": 2 } },
    "final_text_contains": ["UNBOUNDED_PARENT_FINISHED"]
  }
}

