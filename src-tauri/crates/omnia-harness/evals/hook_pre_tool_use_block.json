{
  "name": "hook_pre_tool_use_block",
  "description": "A PreToolUse hook blocks write_file (the process prints a block decision); the tool never runs, the model sees the reason, and reads are unaffected.",
  "requires": ["default_shell"],
  "permission_mode": "full",
  "workspace": { "files": { "r.txt": "readable\n" } },
  "hooks": {
    "PreToolUse": [
      { "matcher": "write_file",
        "hooks": [{ "type": "command", "command": "echo '{\"decision\":\"block\",\"reason\":\"policy: no writes today\"}'", "timeout": 30 }] }
    ]
  },
  "prompts": ["Read r.txt then create w.txt."],
  "script": [
    { "tool_calls": [
        { "name": "read_file", "input": { "path": "r.txt" } },
        { "name": "write_file", "input": { "path": "w.txt", "content": "nope\n" } }
    ] },
    { "when_last_result_contains": "policy: no writes today", "say": "The write was blocked by policy." }
  ],
  "expect": {
    "files": [{ "path": "w.txt", "exists": false }],
    "proposed": { "exact": ["read_file", "write_file"] },
    "executed": { "exact": ["read_file"] },
    "results": [
      { "tool": "write_file", "is_error": true, "contains": "Blocked by a PreToolUse hook: policy: no writes today" },
      { "tool": "read_file", "is_error": false, "contains": "readable" }
    ],
    "final_text_contains": ["blocked by policy"]
  }
}
