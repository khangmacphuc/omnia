{
  "name": "read_edit_write_flow",
  "description": "Read a file, edit it in place, then create a new file. Auto mode: no prompts for ordinary workspace edits.",
  "permission_mode": "auto",
  "workspace": { "files": { "src/app.txt": "hello world\nline two\n" } },
  "prompts": ["Change the greeting in src/app.txt and write a notes file."],
  "script": [
    { "tool_calls": [{ "name": "read_file", "input": { "path": "src/app.txt" } }] },
    { "when_last_result_contains": "hello world",
      "tool_calls": [{ "name": "edit_file", "input": { "path": "src/app.txt", "old_string": "hello world", "new_string": "hello omnia" } }] },
    { "when_last_result_contains": "Edited src/app.txt",
      "tool_calls": [{ "name": "write_file", "input": { "path": "docs/notes.md", "content": "# Notes\ngreeting updated\n" } }] },
    { "say": "Updated the greeting and wrote docs/notes.md.", "usage": { "input": 120, "output": 20 } }
  ],
  "expect": {
    "stop": "end_turn",
    "turns": { "eq": 4 },
    "files": [
      { "path": "src/app.txt", "equals": "hello omnia\nline two\n" },
      { "path": "docs/notes.md", "equals": "# Notes\ngreeting updated\n" }
    ],
    "executed": { "exact": ["read_file", "edit_file", "write_file"] },
    "events": { "approval_requested": { "eq": 0 }, "tool_completed": { "eq": 3 } },
    "no_results": [{ "is_error": true }],
    "final_text_contains": ["docs/notes.md"]
  }
}
