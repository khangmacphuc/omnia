{
  "name": "memory_write_then_prompt",
  "description": "memory_write in two scopes lands on disk and the next run's system prompt carries both indexes (the first run's prompt did not).",
  "tools": "builtin_memory",
  "permission_mode": "full",
  "prompts": ["Remember that I prefer tabs, and that this project uses pnpm.", "What do you remember?"],
  "script": [
    { "tool_calls": [
        { "name": "memory_write", "input": { "scope": "user", "slug": "indent-style", "name": "Indent style", "description": "User prefers tabs over spaces", "body": "Use tabs." } },
        { "name": "memory_write", "input": { "scope": "project", "slug": "package-manager", "name": "Package manager", "description": "Project uses pnpm", "body": "Run pnpm install." } }
    ] },
    { "say": "Saved both." },
    { "say": "You prefer tabs and the project uses pnpm." }
  ],
  "expect": {
    "files": [
      { "path": ".omnia/memory/package-manager.md", "contains": ["Run pnpm install."] },
      { "path": ".omnia/memory/MEMORY.md", "contains": ["package-manager"] }
    ],
    "executed": { "exact": ["memory_write", "memory_write"] },
    "results": [{ "tool": "memory_write", "contains": "Saved user memory `indent-style`" }],
    "requests": [
      { "index": 0, "system_not_contains": ["# Memory", "indent-style"] },
      { "index": -1, "system_contains": ["# Memory", "User memory index", "indent-style", "Project memory index", "package-manager"] }
    ],
    "no_results": [{ "is_error": true }]
  }
}
