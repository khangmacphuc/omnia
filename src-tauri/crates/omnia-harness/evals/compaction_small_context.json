{
  "name": "compaction_small_context",
  "description": "With a tiny context window the prompt crosses the threshold mid-run: older history is summarized (one extra model call), a Compacted event fires and the next request starts with the summary.",
  "permission_mode": "full",
  "workspace": { "files": { "a.txt": "file contents\n" } },
  "config": { "context_window": 1000, "compact_threshold": 0.8 },
  "prompts": ["Look at a.txt.", "Now keep digging."],
  "script": [
    { "tool_calls": [{ "name": "read_file", "input": { "path": "a.txt" } }], "usage": { "input": 10, "output": 5 } },
    { "say": "First look done.", "usage": { "input": 20, "output": 5 } },
    { "tool_calls": [{ "name": "read_file", "input": { "path": "a.txt" } }], "usage": { "input": 30, "output": 5 } },
    { "tool_calls": [{ "name": "read_file", "input": { "path": "a.txt" } }], "usage": { "input": 40, "output": 5 } },
    { "tool_calls": [{ "name": "read_file", "input": { "path": "a.txt" } }], "usage": { "input": 900, "output": 5 } },
    { "kind": "compaction", "say": "SUMMARY-MARKER: user asked to inspect a.txt repeatedly." },
    { "say": "Finished after compaction.", "usage": { "input": 60, "output": 5 } }
  ],
  "expect": {
    "stop": "end_turn",
    "events": { "compacted": { "eq": 1 } },
    "history_len": { "max": 10 },
    "requests": [
      { "index": -1, "messages_contain": ["<summary of earlier conversation>", "SUMMARY-MARKER"] }
    ],
    "final_text_contains": ["Finished after compaction"]
  }
}
