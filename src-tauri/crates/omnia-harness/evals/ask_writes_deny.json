{
  "name": "ask_writes_deny",
  "description": "ask_writes: a denied write never executes, the model sees the user's feedback and the file is untouched.",
  "permission_mode": "ask_writes",
  "workspace": { "files": { "keep.txt": "original\n" } },
  "approval": { "default": "deny", "feedback": "do not touch keep.txt" },
  "prompts": ["Overwrite keep.txt."],
  "script": [
    { "tool_calls": [{ "name": "write_file", "input": { "path": "keep.txt", "content": "clobbered\n" } }] },
    { "when_last_result_contains": "do not touch keep.txt", "say": "Understood, leaving keep.txt alone." }
  ],
  "expect": {
    "files": [{ "path": "keep.txt", "equals": "original\n" }],
    "proposed": { "exact": ["write_file"] },
    "executed": { "exact": [] },
    "events": { "approval_requested": { "eq": 1 }, "tool_started": { "eq": 0 } },
    "results": [{ "tool": "write_file", "is_error": true, "contains": "The user declined this action and said: do not touch keep.txt" }],
    "final_text_contains": ["leaving keep.txt alone"]
  }
}
