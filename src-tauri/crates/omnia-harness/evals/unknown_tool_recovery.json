{
  "name": "unknown_tool_recovery",
  "description": "Calling a tool that does not exist yields an error result naming it; the model recovers with a real tool.",
  "permission_mode": "full",
  "workspace": { "files": { "a.txt": "content\n" } },
  "prompts": ["Read a.txt."],
  "script": [
    { "tool_calls": [{ "name": "cat_file", "input": { "path": "a.txt" } }] },
    { "when_last_result_contains": "Unknown tool `cat_file`", "tool_calls": [{ "name": "read_file", "input": { "path": "a.txt" } }] },
    { "when_last_result_contains": "content", "say": "Got it." }
  ],
  "expect": {
    "proposed": { "exact": ["cat_file", "read_file"] },
    "executed": { "exact": ["read_file"] },
    "results": [{ "is_error": true, "contains": "Unknown tool `cat_file`" }, { "tool": "read_file", "is_error": false }]
  }
}
