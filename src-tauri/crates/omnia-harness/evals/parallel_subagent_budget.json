{
  "name": "parallel_subagent_budget",
  "description": "Parallel sibling tasks share one ledger and cannot start another turn after their combined usage reaches the cap.",
  "tools": "builtin_task",
  "permission_mode": "full",
  "workspace": { "files": { "data.txt": "parallel-fixture\n" } },
  "config": { "token_budget": 100 },
  "allow_unused_turns": true,
  "prompts": ["Run two independent bounded lookups."],
  "script": [
    { "tool_calls": [
      { "name": "task", "input": { "description": "lookup one", "prompt": "Read data.txt.", "subagent_type": "explore" } },
      { "name": "task", "input": { "description": "lookup two", "prompt": "Read data.txt.", "subagent_type": "explore" } }
    ], "usage": { "input": 10, "output": 0 } },
    { "kind": "subagent", "times": 2, "tool_calls": [{ "name": "read_file", "input": { "path": "data.txt" } }], "usage": { "input": 45, "output": 0 } },
    { "say": "PARENT_MUST_NOT_RUN", "usage": { "input": 1, "output": 0 } }
  ],
  "expect": {
    "run_error": "Token budget reached (100/100)",
    "tokens": { "eq": 10 },
    "executed": { "includes": ["task", "read_file"], "count": { "min": 3, "max": 4 } },
    "events": { "budget_warning": { "eq": 1 }, "turn_completed": { "min": 3, "max": 4 }, "run_completed": { "eq": 0 } }
  }
}

