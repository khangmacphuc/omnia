{
  "name": "ask_always_remembers",
  "description": "Answering 'always allow' adds a session rule: the second identical write does not ask again.",
  "permission_mode": "ask_writes",
  "approval": { "decisions": ["always"], "default": "deny" },
  "prompts": ["Write log.txt twice."],
  "script": [
    { "tool_calls": [{ "name": "write_file", "input": { "path": "log.txt", "content": "one\n" } }] },
    { "tool_calls": [{ "name": "write_file", "input": { "path": "log.txt", "content": "two\n" } }] },
    { "say": "Wrote it twice." }
  ],
  "expect": {
    "files": [{ "path": "log.txt", "equals": "two\n" }],
    "executed": { "exact": ["write_file", "write_file"] },
    "events": { "approval_requested": { "eq": 1 } },
    "no_results": [{ "is_error": true }]
  }
}
