{
  "name": "checkpoint_restore",
  "description": "A turn modifies one file and creates another; restoring its checkpoint puts the old content back and deletes the new file.",
  "permission_mode": "full",
  "workspace": { "files": { "keep.txt": "before\n" } },
  "prompts": ["Change keep.txt and create made.txt."],
  "script": [
    { "tool_calls": [
        { "name": "write_file", "input": { "path": "keep.txt", "content": "after\n" } },
        { "name": "write_file", "input": { "path": "made.txt", "content": "new\n" } }
    ] },
    { "say": "Done." }
  ],
  "expect": {
    "files": [
      { "path": "keep.txt", "equals": "after\n" },
      { "path": "made.txt", "exists": true }
    ]
  },
  "restore_checkpoint": 0,
  "after_restore": [
    { "path": "keep.txt", "equals": "before\n" },
    { "path": "made.txt", "exists": false }
  ]
}
