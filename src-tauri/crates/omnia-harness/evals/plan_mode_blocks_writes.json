{
  "name": "plan_mode_blocks_writes",
  "description": "Plan mode: the system prompt says so, reads work, writes and commands are refused without executing or asking.",
  "permission_mode": "plan",
  "workspace": { "files": { "main.rs": "fn main() {}\n" } },
  "approval": { "default": "allow" },
  "prompts": ["Add logging to main.rs."],
  "script": [
    { "tool_calls": [
        { "name": "read_file", "input": { "path": "main.rs" } },
        { "name": "write_file", "input": { "path": "main.rs", "content": "fn main() { println!(); }\n" } },
        { "name": "shell", "input": { "command": "echo hi" } }
    ] },
    { "when_last_result_contains": "Plan mode is read-only",
      "say": "Plan: 1. edit main.rs to add println. 2. run cargo test." }
  ],
  "expect": {
    "files": [
      { "path": "main.rs", "equals": "fn main() {}\n" }
    ],
    "proposed": { "exact": ["read_file", "write_file", "shell"] },
    "executed": { "exact": ["read_file"] },
    "events": { "approval_requested": { "eq": 0 } },
    "results": [
      { "tool": "write_file", "is_error": true, "contains": "Plan mode is read-only" },
      { "tool": "shell", "is_error": true, "contains": "Plan mode is read-only" },
      { "tool": "read_file", "is_error": false, "contains": "fn main" }
    ],
    "requests": [{ "index": 0, "system_contains": ["# Plan mode"] }],
    "final_text_contains": ["Plan:"]
  }
}
