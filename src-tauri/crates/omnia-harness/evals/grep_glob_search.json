{
  "name": "grep_glob_search",
  "description": "glob lists matching files, grep finds content; both read-only so ask_writes never prompts.",
  "permission_mode": "ask_writes",
  "workspace": {
    "files": {
      "src/a.rs": "fn alpha_unique_marker() {}\n",
      "src/b.rs": "fn beta() {}\n",
      "docs/notes.md": "mentions nothing\n"
    }
  },
  "prompts": ["Find the rust files and where alpha_unique_marker lives."],
  "script": [
    { "tool_calls": [{ "name": "glob", "input": { "pattern": "**/*.rs" } }] },
    { "when_last_result_contains": "src/b.rs",
      "tool_calls": [{ "name": "grep", "input": { "pattern": "alpha_unique_marker" } }] },
    { "when_last_result_contains": "src/a.rs", "say": "It is in src/a.rs." }
  ],
  "expect": {
    "executed": { "exact": ["glob", "grep"] },
    "events": { "approval_requested": { "eq": 0 } },
    "results": [
      { "tool": "glob", "contains": "src/a.rs" },
      { "tool": "glob", "contains": "src/b.rs" },
      { "tool": "grep", "contains": "src/a.rs" }
    ],
    "no_results": [
      { "tool": "glob", "contains": "notes.md" },
      { "tool": "grep", "contains": "src/b.rs" },
      { "is_error": true }
    ]
  }
}
