{
  "name": "parent_token_budget_exhaustion",
  "description": "A parent reaches the shared budget before delegation; the child cannot issue a provider request.",
  "tools": "builtin_task",
  "permission_mode": "full",
  "config": { "token_budget": 100 },
  "allow_unused_turns": true,
  "prompts": ["Delegate only after this turn."],
  "script": [
    { "tool_calls": [{ "name": "task", "input": { "description": "must not start", "prompt": "Do not need to run.", "subagent_type": "explore" } }], "usage": { "input": 100, "output": 0 } },
    { "kind": "subagent", "say": "CHILD_MUST_NOT_RUN", "usage": { "input": 1, "output": 0 } },
    { "say": "PARENT_MUST_NOT_RUN", "usage": { "input": 1, "output": 0 } }
  ],
  "expect": {
    "run_error": "Token budget reached (100/100)",
    "tokens": { "eq": 100 },
    "executed": { "exact": ["task"] },
    "events": { "budget_warning": { "eq": 1 }, "turn_completed": { "eq": 1 }, "run_completed": { "eq": 0 },
      "subagent": { "eq": 0 } }
  }
}

