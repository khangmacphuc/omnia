{
  "name": "office_docx_read",
  "description": "read_file extracts the paragraphs of a real .docx (a stored-ZIP fixture generated by the eval runner).",
  "permission_mode": "ask_writes",
  "workspace": { "docx": { "report.docx": ["Quarterly revenue grew 12%", "Second paragraph & more"] } },
  "prompts": ["Summarize report.docx."],
  "script": [
    { "tool_calls": [{ "name": "read_file", "input": { "path": "report.docx" } }] },
    { "when_last_result_contains": "grew 12%", "say": "Revenue grew 12%." }
  ],
  "expect": {
    "results": [
      { "tool": "read_file", "is_error": false, "contains": "Quarterly revenue grew 12%" },
      { "tool": "read_file", "contains": "Second paragraph & more" }
    ],
    "events": { "approval_requested": { "eq": 0 } },
    "final_text_contains": ["12%"]
  }
}
