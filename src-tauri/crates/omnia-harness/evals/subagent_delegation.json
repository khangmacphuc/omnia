{
  "name": "subagent_delegation",
  "description": "The parent delegates a lookup through the task tool; the read-only subagent runs its own loop (own tool calls, own model turns) and the parent receives only its report.",
  "tools": "builtin_task",
  "permission_mode": "ask_writes",
  "workspace": { "files": { "data.txt": "secret-token-42\n" } },
  "prompts": ["Ask a subagent what data.txt contains."],
  "script": [
    { "tool_calls": [{ "name": "task", "input": { "description": "inspect data file", "prompt": "Read data.txt and report its contents.", "subagent_type": "explore" } }] },
    { "kind": "subagent", "tool_calls": [{ "name": "read_file", "input": { "path": "data.txt" } }] },
    { "kind": "subagent", "when_last_result_contains": "secret-token-42", "say": "REPORT: data.txt holds secret-token-42." },
    { "when_last_result_contains": "REPORT:", "say": "The subagent found secret-token-42." }
  ],
  "expect": {
    "stop": "end_turn",
    "proposed": { "exact": ["task", "read_file"] },
    "executed": { "ordered": ["task", "read_file"] },
    "events": { "subagent": { "min": 1 }, "approval_requested": { "eq": 0 } },
    "results": [{ "tool": "task", "is_error": false, "contains": "REPORT: data.txt holds secret-token-42." }],
    "final_text_contains": ["secret-token-42"]
  }
}
