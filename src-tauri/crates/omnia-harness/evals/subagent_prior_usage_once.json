{
  "name": "subagent_prior_usage_once",
  "description": "Prior session usage is seeded once; child admission sees the parent ledger at the limit.",
  "tools": "builtin_task",
  "permission_mode": "full",
  "config": { "token_budget": 100, "initial_tokens_used": 90 },
  "allow_unused_turns": true,
  "prompts": ["Delegate after accounting for earlier work."],
  "script": [
    { "tool_calls": [{ "name": "task", "input": { "description": "must not start", "prompt": "Do not need to run.", "subagent_type": "explore" } }], "usage": { "input": 10, "output": 0 } },
    { "kind": "subagent", "say": "CHILD_MUST_NOT_RUN", "usage": { "input": 1, "output": 0 } }
  ],
  "expect": {
    "run_error": "Token budget reached (100/100)",
    "tokens": { "eq": 10 },
    "executed": { "exact": ["task"] },
    "events": { "budget_warning": { "eq": 0 }, "turn_completed": { "eq": 1 }, "subagent": { "eq": 0 }, "run_completed": { "eq": 0 } }
  }
}

