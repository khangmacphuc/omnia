{
  "name": "max_turns_loop_guard",
  "description": "A model that never stops calling tools is cut off at max_turns with the turn_limit stop reason instead of looping forever.",
  "permission_mode": "full",
  "workspace": { "files": { "a.txt": "x\n" } },
  "config": { "max_turns": 4 },
  "allow_unused_turns": true,
  "prompts": ["Loop."],
  "script": [
    { "times": 100, "tool_calls": [{ "name": "read_file", "input": { "path": "a.txt" } }] }
  ],
  "expect": {
    "stop": "turn_limit",
    "turns": { "eq": 4 },
    "executed": { "count": { "eq": 4 } },
    "models_requested": ["eval-model", "eval-model", "eval-model", "eval-model"]
  }
}
