{
  "name": "token_budget_exceeded",
  "description": "Budget 100: a warning fires once at 90 used, and the run stops with a budget error before a third request once 110 is reached.",
  "permission_mode": "full",
  "workspace": { "files": { "a.txt": "x\n" } },
  "config": { "token_budget": 100 },
  "allow_unused_turns": true,
  "prompts": ["Keep reading."],
  "script": [
    { "tool_calls": [{ "name": "read_file", "input": { "path": "a.txt" } }], "usage": { "input": 60, "output": 30 } },
    { "tool_calls": [{ "name": "read_file", "input": { "path": "a.txt" } }], "usage": { "input": 10, "output": 10 } },
    { "say": "never requested" }
  ],
  "expect": {
    "run_error": "Token budget reached (110/100)",
    "events": { "budget_warning": { "eq": 1 }, "turn_completed": { "eq": 2 }, "run_completed": { "eq": 0 } },
    "tokens": { "eq": 110 },
    "models_requested": ["eval-model", "eval-model"]
  }
}
