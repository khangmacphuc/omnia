{
  "name": "omnia-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first, provider-agnostic AI workspace for Windows 11.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fast": "vite --host 127.0.0.1 --port 1420",
    "preview:fast": "node scripts/launch-fast-preview.mjs",
    "preview:fast:open": "node scripts/launch-fast-preview.mjs --open",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "build": "tsc -b && vite build",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "tokens:generate": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "check:agent-catalog": "node docs/omnia-ultra/tools/validate-agent-catalog.mjs --check",
    "check:conversation-navigation": "node docs/omnia-ultra/tools/validate-conversation-navigation.mjs --check",
    "source-ledger:generate": "node docs/omnia-ultra/tools/generate-source-ledger.mjs",
    "check:source-ledger": "node docs/omnia-ultra/tools/generate-source-ledger.mjs --check && node docs/omnia-ultra/tools/validate-source-ledger.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:contract": "playwright test --config playwright.visual.config.ts tests/visual/visual-fixture-contract.spec.ts",
    "test:visual:update": "node scripts/update-visual-baselines.mjs",
    "test:visual:install": "playwright install chromium",
    "twin:bootstrap": "node scripts/generate-project-twin.mjs",
    "twin:check": "node scripts/generate-project-twin.mjs --check",
    "manifest:verify": "node scripts/verify-source-manifest.mjs --check",
    "verify:run-control-storage": "python scripts/verify-run-control-storage.py",
    "verify:cursor-authority": "python scripts/verify-cursor-authority-contract.py",
    "verify:cursor-authority:required": "python scripts/verify-cursor-authority-contract.py --require-implementation",
    "verify:authoritative-root": "python scripts/verify-authoritative-root-contract.py",
    "verify:authoritative-root:required": "python scripts/verify-authoritative-root-contract.py --require-api",
    "typecheck": "tsc -b --pretty false",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit --pretty false",
    "check:acl": "node scripts/check-tauri-acl.mjs",
    "check:command-parity": "node scripts/check-tauri-command-parity.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "check:hit-targets": "node scripts/check-hit-targets.mjs",
    "check:imports": "node scripts/check-import-boundaries.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "perf:evidence": "node scripts/perf-evidence.mjs",
    "perf:headless": "node scripts/perf-headless-runner.mjs",
    "test:perf-headless": "node --test scripts/perf-headless-runner.test.mjs",
    "inventory:upstream": "node scripts/upstream-preview/build-upstream-inventory.cjs",
    "inventory:catalog": "node scripts/upstream-preview/generate-upstream-capability-catalog.cjs",
    "check:upstream-catalog": "node scripts/upstream-preview/generate-upstream-capability-catalog.cjs --check",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "check": "npm run tokens:check && npm run check:agent-catalog && npm run check:conversation-navigation && npm run check:source-ledger && npm run check:upstream-catalog && npm run check:acl && npm run check:typography && npm run check:hit-targets && npm run check:imports && npm run verify:cursor-authority && npm run verify:authoritative-root && npm run typecheck && npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-os": "^2.3.0",
    "@tauri-apps/plugin-store": "^2.4.0",
    "@tauri-apps/plugin-window-state": "^2.4.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.1",
    "sonner": "^2.0.7",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
