{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnia.local/schemas/retry-policy.schema.json",
  "title": "Omnia retry policy",
  "type": "object",
  "required": ["schemaVersion", "policyId", "maxElapsedSeconds", "scheduleSeconds", "statusRules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyId": { "type": "string", "minLength": 1 },
    "maxElapsedSeconds": { "type": "integer", "minimum": 0, "default": 86400 },
    "maxAttempts": { "type": ["integer", "null"], "minimum": 1 },
    "scheduleSeconds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 },
      "default": [1, 3, 5, 10, 15, 30, 60, 120, 300, 600, 900]
    },
    "maxSingleDelaySeconds": { "type": "integer", "minimum": 1, "default": 900 },
    "jitter": { "enum": ["none", "full", "equal", "decorrelated"], "default": "decorrelated" },
    "honorRetryAfter": { "type": "boolean", "default": true },
    "allowProviderFallback": { "type": "boolean", "default": true },
    "allowModelFallback": { "type": "boolean", "default": true },
    "allowPromptRepair": { "type": "boolean", "default": true },
    "requireSemanticDiffForRepair": { "const": true },
    "statusRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "action"],
        "properties": {
          "status": { "type": "integer", "minimum": 100, "maximum": 599 },
          "action": { "enum": ["stop", "ask_user", "refresh_auth", "fallback", "retry", "repair", "outcome_unknown"] },
          "retryable": { "type": "boolean" },
          "requiresIdempotencyEvidence": { "type": "boolean" },
          "notes": { "type": "string", "maxLength": 2048 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

