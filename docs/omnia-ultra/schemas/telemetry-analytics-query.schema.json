{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnia.local/schemas/telemetry-analytics-query.schema.json",
  "title": "Omnia telemetry analytics query",
  "type": "object",
  "required": ["schemaVersion", "queryId", "metrics", "range", "aggregations", "dimensions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "queryId": { "type": "string", "minLength": 1 },
    "metrics": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "range": {
      "type": "object",
      "required": ["left", "right", "timeZone"],
      "properties": {
        "left": { "$ref": "#/$defs/boundary" },
        "right": { "$ref": "#/$defs/boundary" },
        "preset": { "enum": ["30m", "1h", "2h", "3h", "5h", "6h", "8h", "10h", "12h", "24h", "1d", "2d", "3d", "5d", "1w", "custom"] },
        "timeZone": { "type": "string", "minLength": 1 },
        "bucketSeconds": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "aggregations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["count", "sum", "min", "max", "mean", "median", "p50", "p75", "p90", "p95", "p99", "histogram", "rate", "cumulative", "moving-average", "ema", "anomaly", "change-point", "correlation"] }
    },
    "dimensions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "operator", "value"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "operator": { "enum": ["eq", "neq", "in", "not-in", "gt", "gte", "lt", "lte", "exists"] },
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "coverage": { "enum": ["all", "provider-reported", "locally-observed", "final-only", "include-estimates"] },
    "comparisonQueryId": { "type": ["string", "null"] }
  },
  "$defs": {
    "boundary": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["timestamp", "now", "prompt", "request", "attempt", "message", "conversation", "branch", "model-switch", "error", "retry", "checkpoint", "agent", "task", "artifact", "commit", "build", "test", "bookmark"] },
        "timestamp": { "type": ["string", "null"], "format": "date-time" },
        "targetId": { "type": ["string", "null"] },
        "offsetSeconds": { "type": "integer", "default": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
