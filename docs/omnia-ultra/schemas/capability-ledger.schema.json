{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnia.local/schemas/capability-ledger.schema.json",
  "title": "Omnia Ultra capability coverage ledger",
  "type": "object",
  "required": ["schemaVersion", "ledgerRevision", "capabilities"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "ledgerRevision": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "required": [
        "capabilityId",
        "title",
        "status",
        "canonicalSpec",
        "requirementIds",
        "dependencies",
        "securityClass",
        "implementationModules",
        "schemas",
        "tests",
        "evidence",
        "currentLimitation",
        "nextAction"
      ],
      "properties": {
        "capabilityId": { "type": "string", "pattern": "^OMNIA-CAP-[A-Z0-9-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "status": {
          "enum": [
            "planned",
            "designed",
            "implemented",
            "wired",
            "partial",
            "verified",
            "preview",
            "blocked",
            "release-candidate",
            "shipped"
          ]
        },
        "canonicalSpec": { "type": "string", "minLength": 1 },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^OMNIA-REQ-[A-Z0-9-]+$" },
          "uniqueItems": true
        },
        "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "securityClass": { "type": "string", "minLength": 1 },
        "implementationModules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "schemas": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "tests": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidence": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "currentLimitation": { "type": "string", "minLength": 1 },
        "nextAction": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
