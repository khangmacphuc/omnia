{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnia.local/schemas/source-ledger.schema.json",
  "title": "Omnia Ultra source and provenance ledger",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "ledgerId",
    "ledgerRevision",
    "title",
    "status",
    "lastReviewedAt",
    "scope",
    "policy",
    "crosswalk",
    "sources"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "ledgerId": { "type": "string", "pattern": "^OMNIA-[A-Z0-9-]+$" },
    "ledgerRevision": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "status": { "enum": ["research-ledger", "current", "superseded", "archived"] },
    "lastReviewedAt": { "type": "string", "format": "date-time" },
    "scope": { "$ref": "#/$defs/scope" },
    "policy": { "$ref": "#/$defs/policy" },
    "crosswalk": { "$ref": "#/$defs/crosswalk" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "required": ["purpose", "authority", "notEvidenceOf"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "notEvidenceOf": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["sourceClasses", "hashAlgorithm", "localFileHashMode", "urlReachability", "crosswalk"],
      "properties": {
        "sourceClasses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "hashAlgorithm": { "const": "sha256" },
        "localFileHashMode": { "enum": ["current-content", "historical-content", "not-collected"] },
        "urlReachability": { "enum": ["not-checked", "checked", "partially-checked"] },
        "crosswalk": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "crosswalk": {
      "type": "object",
      "required": ["status", "requirementToSourceMappings", "note"],
      "properties": {
        "status": { "enum": ["not-started", "partial", "complete"] },
        "requirementToSourceMappings": { "type": "array", "items": { "type": "object" } },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "locator": {
      "oneOf": [
        { "$ref": "#/$defs/localLocator" },
        { "$ref": "#/$defs/urlLocator" },
        { "$ref": "#/$defs/repositoryLocator" }
      ]
    },
    "localLocator": {
      "type": "object",
      "required": ["kind", "path", "section"],
      "properties": {
        "kind": { "const": "local-file" },
        "path": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "section": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "urlLocator": {
      "type": "object",
      "required": ["kind", "url", "section"],
      "properties": {
        "kind": { "const": "url" },
        "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "section": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "repositoryLocator": {
      "type": "object",
      "required": ["kind", "repository", "revision", "section"],
      "properties": {
        "kind": { "const": "repository" },
        "repository": { "type": "string", "minLength": 1 },
        "revision": {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "enum": ["git-commit", "tag", "version"] },
            "value": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "section": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["reviewedAt", "freshness", "retrievalStatus", "notes"],
      "properties": {
        "reviewedAt": { "type": "string", "format": "date-time" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "freshness": { "enum": ["current", "historical", "stale", "unknown"] },
        "retrievalStatus": { "enum": ["verified", "documented-only", "not-checked", "unreachable"] },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "contentHash"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "evidenceBoundary": {
      "type": "object",
      "required": ["classification", "limitations"],
      "properties": {
        "classification": { "type": "string", "minLength": 1 },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "crosswalkEntry": {
      "type": "object",
      "required": ["status", "claimIds", "requirementIds", "capabilityIds", "evidenceIds"],
      "properties": {
        "status": { "enum": ["mapped", "partially-mapped", "unmapped"] },
        "claimIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "requirementIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "capabilityIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["sourceId", "title", "sourceClass", "locator", "review", "evidenceBoundary", "crosswalk"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^src\\.[a-z0-9][a-z0-9.-]{1,191}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "sourceClass": {
          "enum": ["internal-research", "normative-contract", "informative-register", "pinned-repository", "official-documentation"]
        },
        "locator": { "$ref": "#/$defs/locator" },
        "review": { "$ref": "#/$defs/review" },
        "integrity": { "$ref": "#/$defs/integrity" },
        "evidenceBoundary": { "$ref": "#/$defs/evidenceBoundary" },
        "crosswalk": { "$ref": "#/$defs/crosswalkEntry" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
