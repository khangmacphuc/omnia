{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnia.local/schemas/goal-requirements.schema.json",
  "title": "Omnia Ultra atomic goal requirement registry",
  "type": "object",
  "required": ["schemaVersion", "registryRevision", "requirements"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "registryRevision": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "requirementId",
        "title",
        "goalDocument",
        "canonicalSpecs",
        "dependencies",
        "schemas",
        "securityClass",
        "acceptanceIds",
        "coverageCapabilityId",
        "targetStatus",
        "supersedes"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "pattern": "^OMNIA-REQ-[A-Z0-9-]+$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "goalDocument": { "type": "string", "pattern": "^goal/.+\\.md$" },
        "canonicalSpecs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^OMNIA-REQ-[A-Z0-9-]+$" },
          "uniqueItems": true
        },
        "schemas": {
          "type": "array",
          "items": { "type": "string", "pattern": "^schemas/.+\\.json$" },
          "uniqueItems": true
        },
        "securityClass": {
          "enum": [
            "local-ui",
            "local-data",
            "provider-network",
            "sensitive-content",
            "external-side-effect",
            "browser-machine",
            "privileged",
            "adaptive-learning"
          ]
        },
        "acceptanceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^OMNIA-ACC-[A-Z0-9-]+$" },
          "uniqueItems": true
        },
        "coverageCapabilityId": {
          "type": "string",
          "pattern": "^OMNIA-CAP-[A-Z0-9-]+$"
        },
        "sourceIntents": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "targetStatus": {
          "description": "Intended terminal maturity for this requirement, not current shipping evidence. Current truth comes only from the linked capability-ledger row and its same-snapshot tests/evidence; a targetStatus of verified must never be rendered as shipped without that evidence.",
          "enum": ["planned", "designed", "implemented", "wired", "verified"]
        },
        "supersedes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^OMNIA-REQ-[A-Z0-9-]+$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
