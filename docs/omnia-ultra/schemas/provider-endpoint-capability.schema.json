{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnia.local/schemas/provider-endpoint-capability.schema.json",
  "title": "Omnia provider endpoint capability snapshot",
  "type": "object",
  "required": ["schemaVersion", "snapshotId", "providerProfileRevisionId", "adapterRevision", "protocolFamily", "apiVersion", "operations", "transports", "authSchemes", "freshness", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "snapshotId": { "type": "string", "minLength": 1 },
    "providerProfileRevisionId": { "type": "string", "minLength": 1 },
    "adapterRevision": { "type": "string", "minLength": 1 },
    "protocolFamily": { "enum": ["openai-responses", "openai-chat-completions", "openai-completions", "openai-compatible", "anthropic-messages", "anthropic-compatible", "google-gemini", "ollama-native", "lmstudio-native", "llama-cpp", "vllm", "tgi", "litellm", "custom"] },
    "apiVersion": { "type": "string", "minLength": 1 },
    "baseUrlHash": { "type": "string", "minLength": 1 },
    "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["responses", "chat-completions", "completions", "messages", "generate-content", "stream-content", "live", "embeddings", "rerank", "token-count", "models", "files", "batches", "realtime", "audio", "images", "video", "moderation", "vector-store", "fine-tuning", "usage", "custom"] } },
    "transports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["http", "sse", "websocket", "polling", "webhook", "local-ipc"] } },
    "authSchemes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["none", "bearer", "api-key-header", "query-key", "oauth2", "aws-sigv4", "azure", "custom"] } },
    "modalities": { "type": "array", "uniqueItems": true, "items": { "enum": ["text", "image", "audio", "video", "embedding", "reranking", "tool", "file"] } },
    "operationCapabilities": {
      "description": "Operation- and model-scoped modality claims. A global modalities list is only a discovery hint and cannot authorize dispatch by itself.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation", "direction", "modality", "supportLevel", "modelScope", "carrierFormats", "mimeFamilies", "fidelity", "probeRequirement", "evidence"],
        "properties": {
          "operation": { "enum": ["responses", "chat-completions", "completions", "messages", "generate-content", "stream-content", "live", "embeddings", "rerank", "token-count", "models", "files", "batches", "realtime", "audio", "images", "video", "moderation", "vector-store", "fine-tuning", "usage", "custom"] },
          "direction": { "enum": ["input", "output", "analysis", "generation", "bidirectional"] },
          "modality": { "enum": ["text", "image", "audio", "video", "pdf", "document", "spreadsheet", "archive", "code", "structured-data", "scientific-artifact", "embedding", "reranking", "tool", "file"] },
          "supportLevel": { "enum": ["documented-native", "model-gated", "adapter-gated", "bridge-required", "unsupported", "unknown"] },
          "modelScope": { "enum": ["all-advertised", "model-family", "model-snapshot", "runtime-profile", "backend-model", "none", "unknown"] },
          "modelSelectors": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "carrierFormats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["inline-data", "url", "provider-file-id", "multipart", "content-block", "realtime-frame", "server-path", "tool-result", "custom"] } },
          "mimeFamilies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["text", "image", "audio", "video", "pdf", "office", "spreadsheet", "archive", "code", "structured-data", "scientific", "other"] } },
          "fidelity": { "enum": ["semantic-and-visual", "semantic-only", "render-required", "model-specific", "not-applicable", "unknown"] },
          "probeRequirement": { "enum": ["not-required", "recommended", "required", "not-permitted"] },
          "constraints": {
            "type": "object",
            "properties": {
              "maxBytes": { "type": ["integer", "null"], "minimum": 0 },
              "maxItems": { "type": ["integer", "null"], "minimum": 0 },
              "maxPages": { "type": ["integer", "null"], "minimum": 0 },
              "maxDurationSeconds": { "type": ["number", "null"], "minimum": 0 },
              "maxWidth": { "type": ["integer", "null"], "minimum": 0 },
              "maxHeight": { "type": ["integer", "null"], "minimum": 0 },
              "notes": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "reference", "retrievedAt"],
              "properties": {
                "kind": { "enum": ["official-documentation", "model-registry", "capability-probe", "adapter-fixture", "user-override"] },
                "reference": { "type": "string", "minLength": 1 },
                "retrievedAt": { "type": "string", "format": "date-time" },
                "contentHash": { "type": ["string", "null"] },
                "expiresAt": { "type": ["string", "null"], "format": "date-time" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "parameterSchemaId": { "type": ["string", "null"] },
    "errorPolicyRevisionId": { "type": "string", "minLength": 1 },
    "usageAuthority": { "enum": ["none", "estimated", "provider-incremental", "provider-final", "invoice"] },
    "freshness": { "enum": ["live-probe", "cached-fresh", "cached-stale", "manual", "unknown"] },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
